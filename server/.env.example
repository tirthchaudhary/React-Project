# Server running port
PORT=3000

# JSON Web Token Secret
JWT_SECRET=your_jwt_secret_here

# MongoDB Connection String (e.g., mongodb+srv://username:password@cluster.mongodb.net)
MONGODB_URI=your_mongodb_uri_here

# ImageKit Configuration (Required for resume picture uploads)
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key_here
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key_here
IMAGEKIT_URL_ENDPOINT=your_imagekit_url_endpoint_here

# OpenAI/Gemini Compatibility API Configuration
OPENAI_API_KEY=your_openai_or_gemini_api_key_here
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-2.0-flash

# Client URL (for CORS allowance)
CLIENT_URL=http://localhost:5173
